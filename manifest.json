{
  "manifest_version": 3,
  "name": "My Chrome Extension",
  "version": "1.0.0",
  "description": "A basic Chrome extension scaffold.",
  "action": {
    "default_title": "Open Ticket Plus Bot"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://ticketplus.com.tw/*",
    "https://*.ticketplus.com.tw/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://ticketplus.com.tw/*", "https://*.ticketplus.com.tw/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
